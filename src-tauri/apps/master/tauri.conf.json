{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iec104-simulator-master",
  "mainBinaryName": "iec104-simulator-master",
  "version": "1.0.0",
  "identifier": "com.iec104-simulator.master",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. dev:master",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../.. build:master",
    "frontendDist": "../../../dist/master"
  },
  "app": {
    "windows": [{
      "title": "IEC104主站模拟器",
      "width": 1400,
      "height": 900,
      "minWidth": 1200,
      "minHeight": 800,
      "resizable": true,
      "fullscreen": false,
      "maximizable": true,
      "minimizable": true,
      "center": true
    }],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "../../icons/master/32x32.png",
      "../../icons/master/128x128.png",
      "../../icons/master/128x128@2x.png",
      "../../icons/master/icon.icns",
      "../../icons/master/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
